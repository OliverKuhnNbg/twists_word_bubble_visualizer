{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": false,
    "paths": {
      "@text-cloud-visualizer-nbg/core": ["./libs/core/src/index.ts"],
      "@text-cloud-visualizer-nbg/data-access": [
        "./libs/data-access/src/index.ts"
      ],
      "@text-cloud-visualizer-nbg/ui": ["./libs/shared/ui/src/index.ts"],
      "@text-cloud-visualizer-nbg/cloud": ["./libs/feature/cloud/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
